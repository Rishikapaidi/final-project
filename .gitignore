venv/
__pycache__/
*.pyc

# Generated datasets: rebuild with the scripts described in data/README.md
data/*
!data/README.md
# Exceptions: the cleaned song list and the preview cache are small and the
# app needs them to run (and to avoid calling the rate-limited preview API)
!data/songs/
data/songs/*
!data/songs/songs_clean.csv
!data/songs/previews.csv
# Raw song sources (large, not committed)
data/songs/raw/

# Trained models: rebuild with scripts/train_text_emotion.py and
# scripts/train_text_emotion_distilbert.py (their reports stay tracked)
models/**/*.joblib
models/**/model/

# Output of the browser tests in tests/ (logs, screenshots, generated test pictures)
tests/output/

# Face-expression ONNX models: download with scripts/fetch_face_models.py (see face_models.py for licences)
models/face/onnx/

# FER2013 example sheets (photos of real people from a research dataset): kept local, not committed.
# Rebuild them with scripts/make_fer2013_sheet.py
docs/fer2013_examples.png
docs/fer2013_misreads.png
